{
  "permissions": {
    "allow": [
      "Bash(./.venv/Scripts/python.exe -m autopost.collect:*)",
      "Bash(./.venv/Scripts/python.exe -m autopost.build:*)",
      "Bash(./.venv/Scripts/python.exe -m autopost.verify:*)",
      "Bash(./.venv/Scripts/python.exe -m autopost.measure:*)",
      "Bash(./.venv/Scripts/python.exe -m autopost.publish * --check)",
      "Bash(./.venv/Scripts/python.exe -m pytest:*)",
      "Bash(git -C autopost-data:*)",
      "Bash(git worktree:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git ls-remote:*)",
      "Bash(git pull -q --ff-only origin main)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(./.venv/Scripts/python.exe -c:*)",
      "Bash(./.venv/Scripts/python.exe -m pip install -q -r autopost/requirements.txt)",
      "Bash(cd:*)",
      "Bash(export:*)",
      "Bash(set:*)",
      "Bash(test:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(mkdir -p /d/카드뉴스/*)",
      "Bash(cp:*)",
      "Read(//d/fashion-cardnews/**)",
      "Read(//d/카드뉴스/**)",
      "Edit(//d/fashion-cardnews/autopost-data/**)",
      "Write(//d/fashion-cardnews/autopost-data/**)",
      "Write(//d/카드뉴스/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start-brief.sh\"",
            "timeout": 15,
            "statusMessage": "PROJECT-BRIEF.md 로드 중..."
          }
        ]
      }
    ]
  }
}
