{
  "permissions": {
    "allow": [
      "Bash(./.venv/Scripts/python.exe -m autopost.collect:*)",
      "Bash(./.venv/Scripts/python.exe -m autopost.build:*)",
      "Bash(./.venv/Scripts/python.exe -m autopost.verify:*)",
      "Bash(./.venv/Scripts/python.exe -m autopost.measure:*)",
      "Bash(./.venv/Scripts/python.exe -m autopost.zzal:*)",
      "Bash(./.venv/Scripts/python.exe -m autopost.publish * --check)",
      "Bash(./.venv/Scripts/python.exe -m autopost.publish * --approve)",
      "Bash(./.venv/Scripts/python.exe -m autopost.publish --next)",
      "Bash(./.venv/Scripts/python.exe -m pytest:*)",
      "Bash(./.venv/Scripts/python.exe -m pip install -q -r autopost/requirements.txt)",
      "Bash(./.venv/Scripts/python.exe -c \"import requests, PIL, playwright\")",
      "Bash(git -C autopost-data add -A)",
      "Bash(git -C autopost-data commit:*)",
      "Bash(git -C autopost-data push -q origin HEAD:claude/autopost-data)",
      "Bash(git -C autopost-data pull -q --ff-only origin claude/autopost-data)",
      "Bash(git -C autopost-data pull -q --rebase origin claude/autopost-data)",
      "Bash(git -C autopost-data status:*)",
      "Bash(git -C autopost-data log:*)",
      "Bash(git -C autopost-data branch -q -u origin/claude/autopost-data)",
      "Bash(git worktree prune)",
      "Bash(git worktree add:*)",
      "Bash(git fetch -q origin:*)",
      "Bash(git merge -q --ff-only origin/main)",
      "Bash(git ls-remote:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "WebSearch",
      "Read(//d/fashion-cardnews/**)",
      "Read(//d/카드뉴스/**)",
      "Edit(//d/fashion-cardnews/autopost-data/**)",
      "Write(//d/fashion-cardnews/autopost-data/**)",
      "Write(//d/카드뉴스/**)"
    ],
    "deny": [
      "Bash(./.venv/Scripts/python.exe -m autopost.publish * --user-approved)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(//d/카드뉴스/ig_api_token*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start-brief.sh\"",
            "timeout": 15,
            "statusMessage": "PROJECT-BRIEF.md 로드 중..."
          }
        ]
      }
    ]
  }
}
