# 백엔드 API 베이스 URL
VITE_API_BASE=http://localhost:8000

# 로컬 카드뉴스 파이프라인 앱의 선택 제출 엔드포인트.
# 미설정 시 http://localhost:8787/api/selections 를 쓴다 (PC에서 앱을 켜고 쓰는 기본 구성).
# 배포본(https)에서는 http://localhost 로의 요청이 mixed-content 로 막히므로,
# 그 환경에서 대시보드 제출을 쓰려면 https 로 접근 가능한 주소를 여기에 넣는다.
VITE_PIPELINE_URL=http://localhost:8787/api/selections
